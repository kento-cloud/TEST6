{
  "name": "pivot-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "render-build": "bash scripts/install-binaries.sh && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "npx tsx src/db/migrate.ts",
    "db:migrate:extras": "npx tsx --env-file=.env.local src/db/migrate-supabase-extras.ts",
    "db:harden": "npx tsx --env-file=.env.local src/db/migrate-supabase-hardening.ts",
    "db:enrich": "npx tsx --env-file=.env.local src/db/update-supabase-ai-contents.ts",
    "db:seed": "npx tsx src/db/seed.ts",
    "db:studio": "npx drizzle-kit studio"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@supabase/supabase-js": "^2.105.4",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "html-to-image": "^1.11.13",
    "next": "16.2.6",
    "openai": "^6.37.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swiper": "^12.1.4",
    "three": "^0.180.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
